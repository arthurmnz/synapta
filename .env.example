# PostgreSQL Configuration
POSTGRES_USER=synapta
POSTGRES_PASSWORD=synapta
POSTGRES_DB=synapta
POSTGRES_HOST_PORT=5432

# Backend SQLAlchemy / Alembic Connection URLs
DATABASE_URL=postgresql+psycopg://synapta:synapta@localhost:5432/synapta
TEST_DATABASE_URL=postgresql+psycopg://synapta:synapta@localhost:5432/synapta_test

# JWT Security (replace with a strong random 32+ char key in production)
SECRET_KEY=replace-with-a-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS & Startup Seed
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEED_ON_START=true

# Frontend (used during Vite build/dev)
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_DEMO_LOGIN=true
